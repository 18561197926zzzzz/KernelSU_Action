# KernelSU Action -- build profile
# 目标: OnePlus 9 (lemonade) / LE2110 / ColorOS 13.1 (Android 13) / kernel 5.4.233-qgki
# 设备实测: LE2110_13.1.0.192(CN01), build 2023-11-03
# 用法: 放进 fork 的 KernelSU_Action 仓库, 命名为 config/lemonade.env
#       或直接覆盖根目录 config.env, 然后 Actions -> Build Kernel -> Run workflow

CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# OnePlus 官方开源 sm8350 内核树
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8350
KERNEL_SOURCE_BRANCH=oneplus/sm8350_t_13.1.0_oneplus9
# 相对 arch/arm64/configs/ 的路径，5.4.233-qgki 由 lahaina_QGKI 定义
KERNEL_CONFIG=vendor/lahaina_QGKI.config
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# 留空则从 KERNEL_CONFIG 推导
KERNEL_NAME=lemonade-susfs
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:

# =================================================================== Clang ==
# 5.4 树用 2022 版 clang 最稳，新版 clang 会因废弃参数报错
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 5.4 支持 LLVM 一体化编译，开这个可以省掉 GCC
USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# 5.4 属于非 GKI, 官方 kernelsu 已砍掉 5.10 以下支持
# sukisu-ultra 的 builtin 是唯一自带 SUSFS 源码的 ref, 不走 susfs4ksu 补丁
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

# 5.4 必须手动 hook, kprobes 在这个版本上会导致装了但 su 不生效
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# builtin ref 自带, 保持 true
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# path_umount() 是 5.9 才有的, 5.4 必须回填, 否则 SUSFS 隐藏 mount 不完整
ENABLE_PATH_UMOUNT=true

# 额外指纹清除, SUSFS 之外的补充层
ENABLE_HIDE_STUFF=true

# KPM 只对 arm64 有效, 与 SUSFS 无冲突
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# 额外 defconfig 行
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false

# 不重新打包 boot.img, 直接用 AnyKernel3 zip 刷入, 保留分区结构
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
